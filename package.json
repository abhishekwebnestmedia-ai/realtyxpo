{
  "name": "realtyxpo-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RealtyXpo CRM - Real Estate Customer Relationship Management System",
  "author": "RealtyXpo Team",
  "license": "Proprietary",
  "scripts": {
    "start": "vite",
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "echo \"Tests not configured yet\" && exit 0",
    "clean": "rm -rf dist",
    "analyze": "npm run build && npx vite-bundle-analyzer dist/stats.html",
    "security-check": "npm audit",
    "pre-deploy": "npm run lint && npm run security-check && npm run build",
    "serve": "npx serve dist -s -l 4173"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-devtools": "^5.87.4",
    "@tanstack/react-table": "^8.21.3",
    "apexcharts": "^5.3.5",
    "axios": "^1.11.0",
    "canvg": "^4.0.3",
    "chart.js": "^4.5.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.12",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.5.28",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-apexcharts": "^1.7.0",
    "react-chartjs-2": "^5.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.1.0",
    "react-helmet": "^6.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router-dom": "^7.8.2",
    "react-select": "^5.10.2",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "simple-datatables": "^10.0.0",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.8.1",
    "swiper": "^11.2.10",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "keywords": [
    "real-estate",
    "crm",
    "react",
    "vite",
    "tailwindcss"
  ]
}
